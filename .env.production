# Production Environment for Vercel Deployment
# Copy this to Vercel's Environment Variables dashboard

# Public API base used by the frontend bundle.
# Production frontend talks directly to the backend origin for cross-origin hosting.
NEXT_PUBLIC_API_URL=https://api.wondertravelers.com

# VPS/backend origin used by Next rewrites/proxying
BACKEND_API_URL=https://api.wondertravelers.com

# Frontend Base URL
NEXT_PUBLIC_BASE_URL=https://www.wondertravelers.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Node Environment
NODE_ENV=production
