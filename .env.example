# SEO Configuration
# Base URL for the application - used for sitemap, canonical URLs, and structured data
NEXT_PUBLIC_BASE_URL=https://wondertravelers.com

# API Configuration
NEXT_PUBLIC_API_URL=https://api.wondertravelers.com

# Google Analytics ID - Add your Google Analytics 4 ID here
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Site Verification Code - Add your Google Search Console verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxx

# Optional: Microsoft Clarity ID for user behavior analytics
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxxxxx

# Optional: Facebook Pixel ID
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=xxxxxxxxxxxxx

# Optional: Hotjar ID for heatmaps and user insights
NEXT_PUBLIC_HOTJAR_ID=xxxxxxxxxxxxx

# Environment
NODE_ENV=production

# SEO Headers - Set to true to enable security headers
ENABLE_SEO_HEADERS=true

# Sitemap Configuration
SITEMAP_BATCH_SIZE=50000

# OpenGraph Image (Used for social sharing)
OG_IMAGE_URL=https://wondertravelers.com/hero-background.jpg

# Twitter Handle
TWITTER_HANDLE=@wondertravelers

# Organization Contact
ORGANIZATION_EMAIL=contact@wondertravelers.com
ORGANIZATION_PHONE=+977-1-XXXXXXX
ORGANIZATION_ADDRESS=Kathmandu, Nepal
